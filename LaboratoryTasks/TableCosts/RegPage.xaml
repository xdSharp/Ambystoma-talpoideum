<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IbragimovLaba5.RegPage"
             Title="RegPage">
    <VerticalStackLayout
        Padding="30,0"
        Spacing="25">
        <Label 
            Text="Регистрация"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Border Style="{StaticResource StyleForBorder}">
            <Entry x:Name="UsernameforReg"  
                Placeholder="Введите имя пользователя"/>
        </Border>

        <Border Style="{StaticResource StyleForBorder}">
            <Entry x:Name="PasswordforReg"
                Placeholder="Введите пароль"/>
        </Border>

        <Button Text="Вернуться назад" 
             Clicked="GoBackToFirstPage"
             Style="{StaticResource ButtonStyleInRegistration}"/>

        <Button Text="Зарегистрироваться"
             Style="{StaticResource ButtonStyleInRegistration}"/>

    </VerticalStackLayout>
</ContentPage>